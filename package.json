{
  "name": "saas-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev:admin": "next dev apps/admin --port 3000",
    "dev:profile": "next dev apps/profile --port 3001",
    "build:admin": "next build apps/admin",
    "build:profile": "next build apps/profile",
    "typecheck": "tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/profile/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^9.4.0",
    "@tanstack/react-query": "^5.102.8",
    "formik": "^2.4.9",
    "msw": "^2.15.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "stylis": "^4.4.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@nx/eslint": "^23.2.0",
    "@nx/eslint-plugin": "^23.2.0",
    "@nx/next": "^23.2.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/stylis": "^4.2.7",
    "eslint": "^10.10.0",
    "nx": "^23.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "apps/admin/public",
      "apps/profile/public"
    ]
  }
}
